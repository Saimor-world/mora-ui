# ============================================
# Production Environment — hq.saimor.world
# Copy to .env.production or pass as Docker
# build args + runtime environment variables.
# ============================================

# NextAuth (REQUIRED — login won't work without these)
NEXTAUTH_URL=https://hq.saimor.world
NEXTAUTH_SECRET=your-secure-random-secret-here-min-32-chars

# Core API
# Build-time (baked into Next.js bundle):
NEXT_PUBLIC_CORE_API_URL=https://api.saimor.world
NEXT_PUBLIC_CORE_WS_URL=wss://api.saimor.world/ws
NEXT_PUBLIC_SAIMOR_CORE_URL=https://api.saimor.world
# Runtime (server-side proxy):
SAIMOR_CORE_URL=http://core:8081

# Surface mode — show guided /entry surface on hq.saimor.world
NEXT_PUBLIC_SURFACE_MODE=hq

# WebGL — enable on hq (production hardware)
NEXT_PUBLIC_DISABLE_WEBGL=false

# Tool execution — require confirmation in production
NEXT_PUBLIC_ALLOW_TOOL_EXECUTION=true

# ============================================
# Real Mora phase flags (P1-P5b)
# All three must be true for the full pipeline.
# Set to false individually to roll back a phase.
# ============================================
NEXT_PUBLIC_MORA_PERCEIVE_V1=true
NEXT_PUBLIC_MORA_DIALOGUE_V1=true
NEXT_PUBLIC_MORA_LIVE_V1=true

# ============================================
# AI Provider (server-side, CORE reads these)
# CORE uses AI_PROVIDER / GEMINI_API_KEY etc.
# The INTERFACE does not call AI directly in hq.
# ============================================
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.0-flash
