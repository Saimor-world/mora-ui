  "rules": {
    "origin": {
      "standard": "Alltagsstücke in allen Farben. Frei für alle Nutzer, in jedem Produkt ab Tag eins, nie ein Wallet nötig.",
      "moment": "Zeitgebunden: begrenzte Auflage oder ein datiertes Fenster, danach nie wieder.",
      "earned": "Verdient: ein Meilenstein, z. B. ein Jahr mit SAIMÔR oder der erste eigene Kunde.",
      "alive": "Lebendig: animiert oder verändert MÔRAs Verhalten (Schwarm folgt ihr, Laterne zündet sich nachts).",
      "founder": "Gründerstücke von Marius. Nicht verkäuflich, nicht übertragbar."
    },
    "rarity": "Nie nach Farbe oder Kategorie. common = standard; rare = moment/earned/alive; legendary = founder oder Auflage ≤ 33.",
    "unlock": {
      "standard": "frei, kein Wallet",
      "abo": "frei nach mindestens N Monaten Abo (months)",
      "nft": "gehört auf der XRP Ledger (nur lesende account_nfts-Prüfung, später)",
      "founder": "nur Gründer"
    }
  }
