{
  "name": "mora-ui",
  "version": "1.0.0-beta.1",
  "private": true,
  "scripts": {
    "predev": "node -e \"process.exit(0)\"",
    "dev": "next dev -p 3000",
    "dev:preview": "next dev -p 3003",
    "dev:core": "powershell -ExecutionPolicy Bypass -File ..\\\\scripts\\\\dev-start.ps1",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "verify:os:smoke": "jest --runInBand __tests__/app/page.session-entry.test.tsx __tests__/components/home/HomeSurface.test.tsx __tests__/components/os/shell/ShellBreadcrumb.test.tsx __tests__/components/os/shell/MoraShell.execution.test.tsx __tests__/components/mora/Dock.navigation.test.tsx __tests__/components/panes/TerminalPane.trust.test.tsx",
    "verify:types": "npx tsc --noEmit -p tsconfig.verify.json",
    "verify:critical-flow": "node scripts/check-critical-flow-gate.mjs --input docs/reports/mr16-baseline-2026-03-05.json",
    "verify:critical-flow:live": "node scripts/check-critical-flow-gate.mjs",
    "verify:mr16:smoke": "npm run verify:types && npm run verify:critical-flow && npm run verify:os:smoke",
    "verify:mr16:smoke:live": "npm run verify:types && npm run verify:critical-flow:live && npx playwright test --config=playwright.live.config.ts e2e/finder-from-l3.spec.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "8.18.0",
    "@tanstack/react-query": "^5.90.6",
    "@types/jsonwebtoken": "^9.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "immer": "^10.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.552.0",
    "next": "15.5.12",
    "next-auth": "^4.24.13",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "overrides": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.181.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "15.5.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
