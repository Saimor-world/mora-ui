# 🌐 MÔRA-UI Configuration Example
# Copy this to .env.local and fill in your values

# ============================================
# CORE API CONNECTION
# ============================================
# URL to saimor-core API
# Local development: http://localhost:8081
# Production: https://voice.saimor.world
NEXT_PUBLIC_CORE_API_URL=http://localhost:8081

# ============================================
# AUTHENTICATION
# ============================================
# JWT Token for API authentication (primary source for the UI)
# Generate with: python scripts/generate_token.py
# Or get from Core API admin (replace placeholder before running)
NEXT_PUBLIC_JWT_TOKEN=PLACEHOLDER_JWT_TOKEN

# Optional fallback token used only when NEXT_PUBLIC_JWT_TOKEN is empty
NEXT_PUBLIC_ADMIN_TOKEN=PLACEHOLDER_ADMIN_TOKEN

# Optional custom auth header name (default Authorization)
# For standard setup leave as Authorization
NEXT_PUBLIC_AUTH_HEADER=Authorization

# ============================================
# CHAT DATASOURCE
# ============================================
# Which datasource should Môra Chat use?
# Options:
#   - "objects"   = Direct /v1/objects queries (fast, simple)
#   - "semantic"  = Semantic search via /v1/semantic/search (AI-powered)
NEXT_PUBLIC_CHAT_SOURCE=objects

# ============================================
# N8N WEBHOOKS (Optional)
# ============================================
# n8n workflow webhook URLs
# Only needed if using Insights workflows
NEXT_PUBLIC_N8N_EMAIL_DIGEST=https://voice.saimor.world/webhook/email-digest
NEXT_PUBLIC_N8N_BROADCAST_DOC=https://voice.saimor.world/webhook/broadcast-doc
NEXT_PUBLIC_N8N_DUPLICATE_HUNTER=https://voice.saimor.world/webhook/duplicate-hunter

# ============================================
# DEVELOPMENT / DIAGNOSTICS
# ============================================
# Show diagnostics panel in dev mode?
# Set to "false" in production
NEXT_PUBLIC_ENABLE_DIAGNOSTICS=true

# ============================================
# OPTIONAL: CORE API BACKEND CONFIG
# (Only needed if running Core API yourself)
# ============================================

# LLM Provider
# Options: anthropic, oss (Ollama)
# LLM_PROVIDER=anthropic

# For OSS (Ollama) LLM
# LLM_OSS_BASE_URL=http://localhost:11434
# LLM_OSS_MODEL=mistral:instruct

# For Anthropic LLM
# ANTHROPIC_API_KEY=sk-ant-...

# Vector Database (Qdrant)
# QDRANT_URL=http://localhost:6333

# Embedding Model
# EMBEDDING_MODEL=all-MiniLM-L6-v2
