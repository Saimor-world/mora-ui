# ============================================
# SAIMOR MORA-UI — Local Development Config
# Copy to .env.local and fill in your values.
# ============================================

# ── Backend ───────────────────────────────────────────────────────────────────
# Proxy route: the browser calls /api/core/... which Next.js forwards here.
NEXT_PUBLIC_CORE_API_URL=/api/core

# LOCAL: leave SAIMOR_CORE_URL commented out → defaults to http://127.0.0.1:8081
# REMOTE (demo/staging):
# SAIMOR_CORE_URL=https://api.saimor.world

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_secret_key_change_me_in_prod

# JWT for direct backend calls (JWT auth path, if used)
# NEXT_PUBLIC_SAIMOR_CORE_JWT=<your_jwt_here>

# ── AI Provider ───────────────────────────────────────────────────────────────
# Option 1: Gemini (Google — KOSTENLOS, empfohlen!)
# API Key: https://aistudio.google.com/apikey
NEXT_PUBLIC_AI_PROVIDER=gemini
NEXT_PUBLIC_AI_API_KEY=<YOUR_GEMINI_API_KEY>
NEXT_PUBLIC_AI_MODEL=gemini-2.0-flash-exp

# Option 2: Claude (Anthropic)
# NEXT_PUBLIC_AI_PROVIDER=anthropic
# NEXT_PUBLIC_AI_API_KEY=sk-ant-...
# NEXT_PUBLIC_AI_MODEL=claude-sonnet-4-6

# Option 3: OpenAI
# NEXT_PUBLIC_AI_PROVIDER=openai
# NEXT_PUBLIC_AI_API_KEY=sk-...
# NEXT_PUBLIC_AI_MODEL=gpt-4o

# Option 4: Ollama (local, free)
# NEXT_PUBLIC_AI_PROVIDER=ollama
# NEXT_PUBLIC_AI_API_KEY=not-needed
# NEXT_PUBLIC_AI_MODEL=llama3.2
# NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# ── WebGL ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DISABLE_WEBGL=false
