# SAIMÔR Core Backend URL
NEXT_PUBLIC_SAIMOR_CORE_URL=http://localhost:8081

# Surface mode:
# - leave empty for the normal local OS
# - set to "hq" on hq.saimor.world to show the guided /entry surface after SSO
NEXT_PUBLIC_SURFACE_MODE=
SAIMOR_ENABLE_LOCAL_DEMO_FALLBACK=0

# Disable WebGL in demo/dev (CSS fallback by default)
NEXT_PUBLIC_DISABLE_WEBGL=true

# Enable MA"RA tool execution (requires confirmation flow)
NEXT_PUBLIC_ALLOW_TOOL_EXECUTION=true

# JWT Token für Backend-Authentifizierung
NEXT_PUBLIC_SAIMOR_CORE_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkZXZlbG9wZXIiLCJ0ZW5hbnRfaWQiOiJkZWZhdWx0IiwiZXhwIjoxNzgwMzU4NDAwfQ.Ow7VZGvHhKz8Nz0Z9Z0Z9Z0Z9Z0Z9Z0Z9Z0Z9Z0Z9Z0

# ============================================
# Real Mora feature flags (P1-P5b)
# Flip to false to roll back individual phases.
# ============================================
NEXT_PUBLIC_MORA_PERCEIVE_V1=true
NEXT_PUBLIC_MORA_DIALOGUE_V1=true
NEXT_PUBLIC_MORA_LIVE_V1=true

# MÔRA reasoning runs only through CORE (see saimor-core ADR 2026-09-09).
# The UI server holds no LLM provider keys.
