# ============================================
# AI Provider Configuration
# ============================================

# Option 1: Gemini (Google - KOSTENLOS, empfohlen!)
# API Key holen: https://aistudio.google.com/apikey
NEXT_PUBLIC_AI_PROVIDER=gemini
NEXT_PUBLIC_AI_API_KEY=<DEIN_GEMINI_API_KEY>
NEXT_PUBLIC_AI_MODEL=gemini-2.0-flash-exp

# Option 2: Claude (Anthropic - Kostenpflichtig)
# API Key holen: https://console.anthropic.com/
# NEXT_PUBLIC_AI_PROVIDER=anthropic
# NEXT_PUBLIC_AI_API_KEY=sk-ant-api03-...
# NEXT_PUBLIC_AI_MODEL=claude-3-5-sonnet-20240620

# Option 3: OpenAI (Kostenpflichtig)
# API Key holen: https://platform.openai.com/api-keys
# NEXT_PUBLIC_AI_PROVIDER=openai
# NEXT_PUBLIC_AI_API_KEY=sk-...
# NEXT_PUBLIC_AI_MODEL=gpt-4o

# ============================================
# Verfügbare Modelle
# ============================================

# Gemini (Google):
# - gemini-2.0-flash-exp (Neueste, schnell, kostenlos)
