# SAIMOR - Production Caddyfile (api + app UI)

{
    email admin@saimor.world
    admin off
}

# Health check port (container-local)
:8080 {
    respond /health 200
}

# API domain (Core + Gateway)
api.saimor.world {
    encode gzip

    @origin_hq header Origin https://hq.saimor.world
    @origin_root header Origin https://saimor.world
    @origin_www header Origin https://www.saimor.world

    header @origin_hq Access-Control-Allow-Origin "https://hq.saimor.world"
    header @origin_root Access-Control-Allow-Origin "https://saimor.world"
    header @origin_www Access-Control-Allow-Origin "https://www.saimor.world"

    header {
        Vary "Origin"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
        Access-Control-Allow-Credentials "true"
        Access-Control-Max-Age "86400"

        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Preflight
    @options method OPTIONS
    handle @options {
        respond "" 204
    }

    # Core API (Universe)
    handle /v1/* {
        reverse_proxy core:8081
    }
    handle /v3/* {
        reverse_proxy core:8081
    }
    handle /docs* {
        reverse_proxy core:8081
    }
    handle /openapi* {
        reverse_proxy core:8081
    }

    # Gateway API (Agents)
    handle /v2/* {
        reverse_proxy gateway:8000
    }
    handle /api/* {
        reverse_proxy gateway:8000
    }

    # n8n Automation Webhooks
    handle_path /n8n/* {
        reverse_proxy n8n:5678
    }
    handle /webhook* {
        reverse_proxy n8n:5678
    }

    handle /health {
        reverse_proxy gateway:8000
    }

    # Default fallback
    handle {
        reverse_proxy gateway:8000
    }

    log {
        output file /var/log/caddy/api-saimor-world.log {
            roll_size 10mb
            roll_keep 20
            roll_keep_for 30d
        }
        format json
        level INFO
    }
}

# App UI domain (Next.js)
hq.saimor.world {
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy ui:3000

    log {
        output file /var/log/caddy/ui-saimor-world.log {
            roll_size 10mb
            roll_keep 20
            roll_keep_for 30d
        }
        format json
        level INFO
    }
}
